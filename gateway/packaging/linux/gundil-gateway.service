[Unit]
Description=Gundil Intercom gateway (cameras over the internet)
After=network-online.target
Wants=network-online.target

[Service]
User=gundil-gateway
ExecStart=/opt/gundil-gateway/gundil-gateway --config=/etc/gundil-gateway.conf
Restart=on-failure
RestartSec=5
StateDirectory=gundil-gateway
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# Self-update replaces the program here; the web page saves the settings.
ReadWritePaths=/opt/gundil-gateway /etc/gundil-gateway.conf

[Install]
WantedBy=multi-user.target
