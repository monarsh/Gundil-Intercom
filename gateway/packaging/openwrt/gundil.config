config gateway 'main'
	# The intercom password, the same as in the apps (10+ characters).
	option password ''
	# The name the apps show.
	option name 'Home router'
	# 1: the apps can reach the cameras on this LAN through this router.
	option share_cameras '0'
	# Optional: other Nostr relays, comma separated.
	# option relays 'wss://relay.damus.io, wss://nos.lol'
