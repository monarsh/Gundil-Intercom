#!/bin/sh /etc/rc.common
# Gundil Intercom gateway: cameras on this LAN reachable from the Gundil
# apps over the internet. Settings: /etc/config/gundil (uci).

START=95
STOP=10
USE_PROCD=1

start_service() {
	config_load gundil
	local password home_key name share relays updates update_server extra_subnets
	config_get password main password ''
	config_get home_key main home_key ''
	config_get name main name 'Home router'
	config_get_bool share main share_cameras 0
	config_get relays main relays ''
	config_get extra_subnets main extra_subnets ''
	config_get_bool updates main updates 1
	config_get update_server main update_server ''
	if [ -z "$password" ] && [ -z "$home_key" ]; then
		logger -t gundil-gateway "not started: set the intercom password (10+ characters) or the home key (pairing code from a paired app), in LuCI (Services > Gundil gateway) or: uci set gundil.main.home_key='GUNDIL-PAIR-...'; uci commit gundil"
		return 1
	fi
	if [ -n "$password" ] && [ ${#password} -lt 10 ]; then
		logger -t gundil-gateway "not started: the intercom password must have 10+ characters"
		return 1
	fi
	mkdir -p /var/etc
	umask 077
	{
		[ -n "$password" ] && echo "password = $password"
		[ -n "$home_key" ] && echo "home_key = $home_key"
		echo "name = $name"
		[ "$share" = 1 ] && echo "share_cameras = true" || echo "share_cameras = false"
		[ -n "$relays" ] && echo "relays = $relays"
		[ -n "$extra_subnets" ] && echo "extra_subnets = $extra_subnets"
		[ "$updates" = 1 ] && echo "updates = true" || echo "updates = false"
		[ -n "$update_server" ] && echo "update_server = $update_server"
	} > /var/etc/gundil-gateway.conf
	procd_open_instance
	procd_set_param command /usr/bin/gundil-gateway --config=/var/etc/gundil-gateway.conf
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger gundil
}
