config server 'main'
	# The web page (admin only); use the LAN address to keep it off the WAN,
	# e.g. 192.168.1.1:8780.
	option listen '0.0.0.0:8780'
	# Where the key, devices and versions are kept. On a small router keep
	# file copies off (download from GitHub), or point this at a USB disk.
	option data_dir '/etc/gundil-update-server'
	option github_repo 'monarsh/Gundil-Intercom'
	# Optional: other Nostr relays, comma separated.
	# option relays 'wss://relay.damus.io, wss://nos.lol'
