#!/bin/sh /etc/rc.common
# Gundil Intercom update server. Settings: /etc/config/gundil-update (uci).

START=96
STOP=10
USE_PROCD=1

start_service() {
	config_load gundil-update
	local listen data_dir repo relays
	config_get listen main listen '0.0.0.0:8780'
	config_get data_dir main data_dir '/etc/gundil-update-server'
	config_get repo main github_repo 'monarsh/Gundil-Intercom'
	config_get relays main relays ''
	mkdir -p /var/etc
	umask 077
	{
		echo "listen = $listen"
		echo "data_dir = $data_dir"
		echo "web_dir = /www/gundil-update-server"
		echo "github_repo = $repo"
		[ -n "$relays" ] && echo "relays = $relays"
	} > /var/etc/gundil-update-server.conf
	procd_open_instance
	procd_set_param command /usr/bin/gundil-update-server --config=/var/etc/gundil-update-server.conf
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger gundil-update
}
